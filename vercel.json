{
    "version": 2,
    "buildCommand": "npm run build",
    "devCommand": "npm run dev",
    "installCommand": "npm install",
    "framework": "nextjs",
    "regions": [
        "icn1"
    ],
    "crons": [
        {
            "path": "/api/cron/allocate",
            "schedule": "1 15 * * 0-4"
        },
        {
            "path": "/api/cron/allocate",
            "schedule": "15 15 * * 0-4"
        }
    ],
    "headers": [
        {
            "source": "/api/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        }
    ]
}